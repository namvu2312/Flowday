{
  "entities": {
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "A personal study or work schedule item with smart reminders and recurrence.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Title of the study session or work task.",
          "minLength": 1,
          "maxLength": 140
        },
        "notes": {
          "type": "string",
          "description": "Optional short notes or location.",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "description": "Item category.",
          "enum": ["study", "work"]
        },
        "date": {
          "type": "string",
          "description": "Scheduled date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "startTime": {
          "type": "string",
          "description": "Start time in HH:mm 24-hour format.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "endTime": {
          "type": "string",
          "description": "End time in HH:mm 24-hour format.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "priority": {
          "type": "string",
          "description": "Task priority level.",
          "enum": ["high", "medium", "low"]
        },
        "repeat": {
          "type": "string",
          "description": "Recurrence pattern.",
          "enum": ["none", "daily", "weekdays", "weekly"]
        },
        "reminderMinutes": {
          "type": "array",
          "description": "Lead-time reminder offsets in minutes before startTime."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the item is completed."
        },
        "snoozedUntil": {
          "type": "number",
          "description": "Epoch milliseconds until reminder is snoozed (0 if not snoozed)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "title",
        "category",
        "date",
        "startTime",
        "endTime",
        "priority",
        "repeat",
        "reminderMinutes",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User theme color, dark mode, and smart reminder preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "themeMode": {
          "type": "string",
          "description": "Color mode preference.",
          "enum": ["light", "dark", "system"]
        },
        "accentColor": {
          "type": "string",
          "description": "Hex accent color chosen by user.",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "quietHoursEnabled": {
          "type": "boolean",
          "description": "Whether quiet hours mute non-urgent reminders."
        },
        "quietHoursStart": {
          "type": "string",
          "description": "Quiet hours start time in HH:mm.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "quietHoursEnd": {
          "type": "string",
          "description": "Quiet hours end time in HH:mm.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "pushEnabled": {
          "type": "boolean",
          "description": "Whether push/browser notifications are enabled."
        },
        "smartLeadHigh": {
          "type": "number",
          "description": "Default lead minutes for high priority tasks."
        },
        "smartLeadMedium": {
          "type": "number",
          "description": "Default lead minutes for medium priority tasks."
        },
        "smartLeadLow": {
          "type": "number",
          "description": "Default lead minutes for low priority tasks."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "themeMode",
        "accentColor",
        "quietHoursEnabled",
        "quietHoursStart",
        "quietHoursEnd",
        "pushEnabled",
        "smartLeadHigh",
        "smartLeadMedium",
        "smartLeadLow",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/ScheduleItem"
      },
      "description": "User's personal study and work schedule items."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/UserPreferences"
      },
      "description": "User's theme and smart reminder settings."
    }
  }
}
